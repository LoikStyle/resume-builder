# 飞书自建应用凭证（飞书开放平台 https://open.feishu.cn/app 申请）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书多维表格（在表格 URL 里能找到这两个 ID）
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# Session 签名密钥（建议用 openssl rand -hex 32 生成）
SESSION_SECRET=

# 管理后台访问 Token（自己设一个字符串）
ADMIN_TOKEN=

# 子路径部署时填（如部署在 /resume 子路径下填 /resume）
# 部署在根路径时留空或删除此行
NEXT_PUBLIC_BASE_PATH=
